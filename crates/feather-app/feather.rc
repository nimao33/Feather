#include <winver.h>

1 24 "feather.manifest"
1 ICON "feather.ico"

// FEATHER_VERSION (1,0,0,0) and FEATHER_VERSION_TEXT ("1.0.0") come from
// Cargo.toml through build.rs. The installer compares this version to
// decide whether to replace an installed feather.exe.
VS_VERSION_INFO VERSIONINFO
FILEVERSION FEATHER_VERSION
PRODUCTVERSION FEATHER_VERSION
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "nimao33"
            VALUE "FileDescription", "Feather"
            VALUE "FileVersion", FEATHER_VERSION_TEXT
            VALUE "InternalName", "feather"
            VALUE "LegalCopyright", "MIT License"
            VALUE "OriginalFilename", "feather.exe"
            VALUE "ProductName", "Feather"
            VALUE "ProductVersion", FEATHER_VERSION_TEXT
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
